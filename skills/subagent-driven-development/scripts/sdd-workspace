#!/usr/bin/env bash
# Resolve and ensure the directory SDD uses for its short-lived artifacts:
# implementer reports, review packages, and the progress ledger. Print the
# directory's absolute path.
#
# A feature owns one directory that holds everything about it, mirroring the
# spec and plan layout:
#
#   $HOME/.superpowers/<YYYY>/<feature-name>/
#     spec/spec.md
#     plan/plan.md                     (index)
#     plan/tasks/task.NN.md            (one task per file)
#     sdd/                             (this workspace)
#
# The workspace is the `sdd/` sibling of the plan's directory, derived from
# the plan file path so there is no year or slug to parse or keep in sync.
# It lives outside the repo, so it is never touched by `git status`,
# `git clean`, or Claude Code's .git/ write protection, and one stable
# location is shared across git worktrees — the progress ledger survives
# when work moves between them.
#
# Usage: sdd-workspace PLAN_FILE
#   PLAN_FILE is the plan index path (…/<feature-name>/plan/plan.md).
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: sdd-workspace PLAN_FILE" >&2
  exit 2
fi

plan=$1
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

plan_dir=$(cd "$(dirname "$plan")" && pwd)   # …/<feature-name>/plan
feature_dir=$(dirname "$plan_dir")           # …/<feature-name>
dir="$feature_dir/sdd"
mkdir -p "$dir"
printf '%s\n' "$dir"
