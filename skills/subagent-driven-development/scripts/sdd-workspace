#!/usr/bin/env bash
# Resolve and ensure the directory SDD uses for its short-lived artifacts:
# implementer reports, review packages, and the progress ledger. Print the
# directory's absolute path.
#
# The workspace lives under $HOME/.superpowers/sdd/YYYY/<feature-slug>/,
# mirroring where spec and plan files live (…/.superpowers/plans/YYYY/
# YYYY-MM-DD-<feature-name>.plan.md). Keeping it outside the repo means it
# is never touched by `git status`, `git clean`, or Claude Code's .git/
# write protection, and one stable location is shared across git worktrees
# so the progress ledger survives when work moves between them.
#
# FEATURE_SLUG is the plan filename stem — YYYY-MM-DD-<feature-name> — so a
# run's artifacts sit beside nothing but its own. The leading YYYY becomes
# the year directory.
#
# Usage: sdd-workspace FEATURE_SLUG
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: sdd-workspace FEATURE_SLUG   (e.g. 2026-07-12-my-feature)" >&2
  exit 2
fi

slug=$1
case "$slug" in
  [0-9][0-9][0-9][0-9]-*) year=${slug%%-*} ;;
  *) echo "FEATURE_SLUG must start with a year: YYYY-MM-DD-<feature-name>" >&2; exit 2 ;;
esac

dir="${HOME}/.superpowers/sdd/${year}/${slug}"
mkdir -p "$dir"
printf '%s\n' "$dir"
